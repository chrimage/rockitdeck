#_preseed_V1
# Debian 13 (trixie) netinst preseed for a DISPOSABLE QEMU VM, used by vm.sh.
#
# WARNING: DESTRUCTIVE, VM-ONLY. NOT A SAFE PUBLIC INSTALLER.
# It wipes /dev/vda without prompting, locks the account password, and grants
# the lab user 'debian' passwordless sudo. Never use it on physical hardware.
#
# Placeholder substituted by vm.sh:
#   @SSH_PUBLIC_KEY@  one-line lab public key for the 'debian' user

### Localization
d-i debian-installer/locale string en_US.UTF-8
d-i localechooser/supported-locales multiselect en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select us

### Network
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string debian-vm
d-i netcfg/get_domain string
d-i netcfg/wireless_wep string

### Mirror
d-i mirror/protocol string http
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string
d-i mirror/suite string trixie

### Accounts: no root login; 'debian' has a locked password ("!"), SSH key only.
# Do not use 'admin': Debian's installer reserves that username.
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string Lab Administrator
d-i passwd/username string debian
d-i passwd/user-password-crypted password !

### Clock
d-i clock-setup/utc boolean true
d-i time/zone string UTC
d-i clock-setup/ntp boolean true

### Partitioning: whole disk, /dev/vda only
d-i partman-auto/disk string /dev/vda
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman/default_filesystem string ext4
d-i partman-basicfilesystems/no_swap boolean false
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-md/confirm boolean true

### Apt
d-i apt-setup/cdrom/set-first boolean false
d-i apt-setup/cdrom/set-next boolean false
d-i apt-setup/cdrom/set-failed boolean false
d-i apt-setup/disable-cdrom-entries boolean true
d-i apt-setup/use_mirror boolean true

### Packages: no desktop, no upgrade
tasksel tasksel/first multiselect standard
d-i pkgsel/include string openssh-server sudo ca-certificates curl
d-i pkgsel/upgrade select none
d-i pkgsel/update-policy select none
popularity-contest popularity-contest/participate boolean false

### Bootloader: BIOS GRUB on the VM disk only
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/bootdev string /dev/vda

### Finish (priority=critical on the kernel command line avoids the pause)
d-i cdrom-detect/eject boolean true
d-i finish-install/reboot_in_progress note

### Lab access: key-only SSH and passwordless sudo for 'debian'
d-i preseed/late_command string \
    in-target install -d -m 0700 -o debian -g debian /home/debian/.ssh; \
    printf '%s\n' '@SSH_PUBLIC_KEY@' > /target/home/debian/.ssh/authorized_keys; \
    in-target chown debian:debian /home/debian/.ssh/authorized_keys; \
    in-target chmod 0600 /home/debian/.ssh/authorized_keys; \
    printf '%s\n' 'debian ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/90-vm-lab; \
    in-target chmod 0440 /etc/sudoers.d/90-vm-lab; \
    in-target systemctl enable ssh.service
